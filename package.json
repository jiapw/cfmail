{
  "name": "cfmail",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-vendor.mjs",
    "vendor": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "libav": "bash scripts/build-libav.sh",
    "dev": "node scripts/sync-vendor.mjs --check && wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply cfmail --local",
    "migrate:remote": "wrangler d1 migrations apply cfmail --remote",
    "deploy:worker": "node scripts/sync-vendor.mjs --strict && wrangler deploy"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "agents": "^0.20.1",
    "ai": "^7.0.60",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "hono": "^4.6.0",
    "marked": "^18.0.10",
    "marked-footnote": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postal-mime": "^2.3.0",
    "qpdf-wasm-esm-embedded": "^1.1.1",
    "quill": "^2.0.3",
    "workers-ai-provider": "^4.0.0",
    "wrangler": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@radix-ui/colors": "^3.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0"
  }
}
