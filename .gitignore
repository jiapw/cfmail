# ---------------------------------------------------------------------------
# 密钥与凭据 —— 仓库是公开的,这一段任何时候都不要放宽
# ---------------------------------------------------------------------------
.env
.env.*
# deploy.mjs 交互模式经用户同意保存的 token。上面的 .env.* 已经罩住它,
# 仍然按名字单列:这一行是防线也是文档,哪怕文件现在还不存在。
# The token deploy.mjs saves with explicit consent. Covered by .env.* above,
# and still listed by name: this line is both a guard and the documentation,
# even while the file does not exist yet.
.env.deploy.token
.dev.vars
.dev.vars.*
*.pem
*.key
!public/**/*.key

# 本机的部署配置:含 account_id / database_id / 你自己的域名,属于生成物。
# 模板见 wrangler.example.jsonc,由 scripts/deploy.mjs 按输入生成。
wrangler.jsonc
# 同一份 checkout 部署到第二个 CF 账号时,那个账号自己的配置(wrangler.example.jsonc 不受影响)
wrangler.acct-*.jsonc

# ---------------------------------------------------------------------------
# 本地运行状态
# ---------------------------------------------------------------------------
# .wrangler/ 里是 miniflare 的本地 D1 和 R2 —— 开发时导入过的真实邮件都在里面
.wrangler/
node_modules/

# 浏览器直接加载的第三方库,由 npm install / npm run vendor 从 node_modules 同步。
# 不入库:600 个文件全是拷贝,而且手工维护挡不住它和 node_modules 版本漂移
# (postal-mime 两端版本必须一致,否则附件 part_index 会错位)。
# Excluding the contents rather than the directory: git does not descend into an excluded
# directory, so a rule that re-includes something inside one never gets the chance to fire.
# 排除的是内容而不是那个目录:git 不会走进一个被排除的目录,
# 于是一条把里面某样东西重新纳入的规则,永远等不到生效的机会。
public/vendor/*

# One exception, and the reason it is one. Everything else under vendor/ can be thrown away and
# remade from node_modules; this build cannot, because upstream does not publish it — the codecs
# it turns on are the ones whose patent situation makes a maintainer decline to ship binaries. So
# the configuration lives in scripts/build-libav.sh and the result has to live here, in the
# repository, or it exists on exactly one machine.
# 一个例外,以及它成为例外的理由。vendor/ 下的其余一切都可以扔掉、再从 node_modules 造出来;
# 这份构建不行,因为上游不发布它 —— 它开启的那些编码,其专利状况让维护者不愿分发二进制。
# 所以配置住在 scripts/build-libav.sh 里,而产物必须住在这里、住在仓库里,
# 否则它只存在于唯一一台机器上。
!public/vendor/libav-full/

# where build-libav.sh does its work / build-libav.sh 干活的地方
.libav-build/
dist/
.cache/
*.log

# Export-Mailbox.ps1 的默认输出目录,以及导出/导入过程中落地的邮件
export/
*.eml
*.mbox

# ---------------------------------------------------------------------------
# 编辑器与本机工具配置(含绝对路径,对别人没意义)
# ---------------------------------------------------------------------------
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# 操作系统垃圾
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# 杂项
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
coverage/
.nyc_output/

# AI 助手 / 一次性脚本的落地物。这类东西本来就该写在仓库外的临时目录里,
# 万一落在了工作区,这几条兜住,别让它们混进公开仓库。
# Scratch output from AI assistants and one-off scripts. These belong in a temp
# directory outside the repo; these patterns are the backstop if one lands here.
*.tmp.*
tmp/
.tmp/
scratch/
scratchpad/
.claude-scratch/
wrangler.tmp*.jsonc

# scripts/restore.mjs 恢复过程中的临时文件
.restore.tmp
.restore.*.sql
*.local.mjs
*.verify.mjs

# 早先误建的 0 字节野文件(字体走 R2 缓存,不落仓库)
/fonts

# 本地 Rspamd 实验环境(容器、配置、压测语料),不入库
rspamd-lab/
